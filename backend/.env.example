# ================================================================
# Environment Variables — Backend Configuration
# ================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ================================================================

# --- Environment ---
NODE_ENV=production
# Extra flags passed to the Node.js runtime (read by Node itself, not the app).
NODE_OPTIONS=
# Port the server listens on (defaults to 3000 when unset).
PORT=3000
# Public base URL of THIS backend (no trailing slash), used to build the
# status_link returned by the payment webhook. Must match PORT. Examples:
#   http://localhost:3000                       (this machine only)
#   http://192.168.1.20:3000                    (Termux LAN)
#   https://<name>.trycloudflare.com            (Cloudflare Tunnel)
BASE_URL=http://localhost:3000
# Origin of the frontend when it is served by a DIFFERENT host than the API.
# Same-origin requests (backend serving the HTML) and localhost / private-LAN
# origins are always accepted, so no change is needed for a new LAN IP or a
# rotating tunnel hostname.
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend: Store Location (build-time injection) ---
# Injected into index.html at build time by the root-level inject-secrets.js,
# which replaces the __STORE_LOCATION__ placeholder. Set the real address in the
# Render dashboard (Environment Variables), NOT in this file — this file is
# committed. Leave empty and the fallback text "Store location coming soon"
# is rendered instead.
STORE_LOCATION=

# --- Frontend: Contact Support (build-time injection) ---
# Configure the "Contact Support" details shown on the live site. These are
# injected at build time by the root-level inject-secrets.js, which replaces the
# __FACEBOOK_PAGE_NAME__ / __FACEBOOK_URL__ / __CONTACT_NUMBER__ /
# __SUPPORT_EMAIL__ placeholders in error.html and status.html (the Contact
# Support modal) and __SUPPORT_EMAIL__ in the index.html / success.html footers.
# Set the real values in the Render dashboard (Environment Variables), NOT in
# this file — this file is committed. Any value left empty is hidden on the live
# site instead of rendering a broken tel:/mailto: link.
FACEBOOK_PAGE_NAME=
FACEBOOK_URL=
CONTACT_NUMBER=
SUPPORT_EMAIL=

# --- Omada Controller ---
# OMADA_BASE_URL holds the Cloudflare Tunnel hostname in production
# (e.g. https://omada-tunnel.example.com). It is NOT the LAN address —
# the controller is reached through the tunnel, not 192.168.1.252:8043.
OMADA_BASE_URL=https://omada-tunnel.example.com
OMADA_SITE=Default
# Hotspot portal operator account (Hotspot Management → Portal operator
# credentials). Used for POST /{OMADAC_ID}/api/v2/hotspot/login — the
# controller session (cookie + Csrf-Token) for all /hotspot/extPortal/* calls:
OMADA_PORTAL_OPERATOR_NAME=your-portal-operator-username
OMADA_PORTAL_OPERATOR_PASSWORD=your-portal-operator-password
# Controller ADMINISTRATOR account — used ONLY for privileged API calls:
# reading the site list and PATCHing per-client rate limits (QoS). Omada
# refuses administrator accounts on the hotspot portal endpoints and the
# portal operator above has no site/QoS rights (it returns 0 sites), so both
# credential sets are required. Signs in at /{OMADAC_ID}/api/v2/login.
OMADA_ADMIN_NAME=your-controller-admin-username
OMADA_ADMIN_PASSWORD=your-controller-admin-password
# Legacy/alternate operator credential names kept for older deployments.
# The backend authenticates with OMADA_PORTAL_OPERATOR_NAME/PASSWORD above;
# these are optional and may be left empty.
OMADA_USER=
OMADA_USERNAME=
OMADA_PASSWORD=
# Omada Controller ID (OMADAC ID) as shown in the controller's API settings:
OMADA_OMADAC_ID=your-omadac-id
OMADA_AUTH_TIMEOUT=10000
# Unit for the `time` field of /hotspot/extPortal/auth: 'ms' | 'us' | 's'.
# DEFAULT IS 'ms' (matches the two cross-verified working implementations).
# This is the ONE env-tunable Omada value because the correct unit depends
# on controller firmware, which varies by deployment — see config/index.js.
# OC200/ER605 controllers present a SELF-SIGNED certificate. The default
# (unset / "false") accepts it so a cloud backend (Render) does not drop the
# TLS handshake. Set to "true" ONLY for a controller with a trusted cert:
OMADA_TLS_REJECT=false
# Set to "true" to bypass the controller entirely (mock mode for testing):
OMADA_MOCK=false

# --- Omada Cloud Northbound Open API (Client Credentials) ---
# Alternative to the tunnel above: when the controller sits behind Carrier-Grade
# NAT and cannot be reached inbound, authorize guests through TP-Link's cloud
# instead. Create the app in the controller at
# Settings > Platform Integration > Open API > Add New App and pick
# "Client Credentials" mode, then copy the Client ID, Client Secret and Omada ID.
# NOTE: a CLOUD-BASED controller needs the paid Standard tier or higher —
# Omada Cloud Essentials has no Open API support.
# API host for your region: us=use1, eu=euw1, ap=aps1.
# Set EITHER the region OR the full base URL:
OMADA_NORTHBOUND_REGION=us
OMADA_NORTHBOUND_BASE_URL=https://use1-omada-northbound.tplinkcloud.com
# Open API app credentials. services/omada-northbound.js reads these from
# process.env at CALL time, so rotating a secret takes effect on the next
# request instead of requiring a restart:
OMADA_CLIENT_ID=your-openapi-client-id
OMADA_CLIENT_SECRET=your-openapi-client-secret
# The older OMADA_NORTHBOUND_CLIENT_ID / OMADA_NORTHBOUND_CLIENT_SECRET names
# are still accepted as fallbacks for existing deployments.
# The Northbound API addresses sites by numeric ID, but the client resolves it
# automatically: on first use it calls GET /openapi/v1/{omadacId}/sites, matches
# the OMADA_SITE name defined above, and caches the resulting ID for all
# subsequent calls. No separate site-id variable is needed.
# Set to "true" to bypass the cloud entirely (mock mode for testing):
OMADA_NORTHBOUND_MOCK=false

# --- Database ---
# Render provides DATABASE_URL automatically from the PostgreSQL add-on.
# Local development (SQLite):
#   DATABASE_URL=sqlite:./data/portal.db
# The DATABASE_URL above is managed by Render — do not override manually.
# When running locally, set it to the SQLite form.

# --- Session Defaults ---
DEFAULT_SESSION_DURATION=60
SESSION_DURATION_OPTIONS=60,120,180,360,720,1440
PAUSE_ENABLED=true
# How often the expiration worker checks sessions (milliseconds):
SESSION_ENFORCE_INTERVAL=60000

# --- Dual-Tier Voucher Pricing ---
# Base price per hour in centavos (used for dynamic pricing on /create endpoint)
PRICE_PER_HOUR=5000
# Premium price multiplier applied on top of standard pricing
PREMIUM_PRICE_MODIFIER=1.5
# Premium sessions can be paused for up to this many hours (7 days = 168)
PREMIUM_PAUSE_VALIDITY_HOURS=168
# Admin API key for /api/admin/* routes
ADMIN_API_KEY=change-this-to-a-random-32-char-hex-key
ADMIN_USERNAME=admin
# Admin login password for POST /api/admin/login (defaults to ADMIN_API_KEY).
ADMIN_PASSWORD=change-this-to-a-random-admin-password

# --- Redirect Allowlist ---
# Comma-separated list of domains allowed as redirect targets (after auth).
# Empty = allow any http/https URL.
ALLOWED_REDIRECT_DOMAINS=
DEFAULT_REDIRECT_URL=https://www.google.com

# --- MacroDroid Payment Webhook ---
# Shared secret sent by MacroDroid in the request body (secret_token).
# The value is compared in constant time; use a long random string.
MACRODROID_WEBHOOK_SECRET=change-this-to-a-long-random-secret
# Paid Wi-Fi time allocation: minutes granted per whole unit of currency
# received. Example: amount 50 with PESOS_PER_MINUTE=10 → 5 minutes.
MACRODROID_PESOS_PER_MINUTE=10

# --- MacroDroid SMS webhook (post-claim text message) ---
# POST /api/payment/claim POSTs the claimed voucher here so a MacroDroid macro
# can text the code to the customer's mobile_number. OPTIONAL: when unset, no
# SMS is attempted and the claim still succeeds unchanged.
# The call is fire-and-forget — it is dispatched without blocking the response
# and any failure is logged only, so an unreachable SMS endpoint can never turn
# a successful claim into an error for the customer.
# Request body (JSON):
#   { target_number, voucher_code, ref_suffix, ref_no, authorized, minutes,
#     status_link? }   status_link is included only when BASE_URL is set.
MACRODROID_SMS_WEBHOOK_URL=

# --- Voucher QoS (bandwidth caps) ---
# Applied by services/omada-northbound.js setClientRateLimit() right after a
# guest is authorized, so a paid session is capped instead of running at the
# site default. Values are parsed with parseInt(...,10) and must be integers
# between 1 and 1024.
VOUCHER_DEFAULT_DOWN_MBPS=10
VOUCHER_DEFAULT_UP_KBPS=512

# --- Premium tier QoS (POST /api/webhooks/instapay) ---
# A payment whose amount is one of PREMIUM_AMOUNTS_PESOS (comma-separated, in
# Pesos) gets the premium caps below instead of the VOUCHER_DEFAULT_* values.
# Leave PREMIUM_DOWN_MBPS / PREMIUM_UP_KBPS unset to fall back to the defaults.
PREMIUM_AMOUNTS_PESOS=25,45,80
PREMIUM_DOWN_MBPS=50
PREMIUM_UP_KBPS=1024

# --- InstaPay / PESONet Webhook ---
# POST /api/webhooks/instapay authorizes the paying device immediately through
# the Omada cloud (no voucher, no inbound controller access). Optional — when
# unset, the route falls back to MACRODROID_WEBHOOK_SECRET.
INSTAPAY_WEBHOOK_SECRET=

# --- Payment Method Configuration (captive portal QR modal) ---
# Receiver details and QR images served by GET /api/payment/methods so that
# no payment information is hard-coded in the frontend. Each value defaults
# to an empty string when unset. The *_QR_B64 values are complete data URI
# strings, e.g. data:image/png;base64,iVBORw0KGgo...
GCASH_NAME=
GCASH_NUMBER=
GCASH_QR_B64=
MAYA_NAME=
MAYA_NUMBER=
MAYA_QR_B64=
QRPH_NAME=
QRPH_NUMBER=
QRPH_QR_B64=

# --- Security ---
# PostgreSQL TLS: Set to "false" for Render PostgreSQL (self-signed certs).
# Set to "true" only for local PostgreSQL with valid certs.
PG_SSL_REJECT_UNAUTHORIZED=false
JWT_SECRET=change-this-to-a-random-secret-in-production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20
# Comma-separated extra CORS origins (cross-origin frontends only). Requests
# whose Origin matches the Host they arrived on, plus localhost and private
# 10.x / 192.168.x / 172.16-31.x origins, are allowed without being listed.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Logging ---
LOG_LEVEL=info
